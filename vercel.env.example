# =============================================================================
# Vercel environment variables — required for production redeploy
# =============================================================================
# Fastest setup: ./scripts/provision_vercel_neon.sh  (after npx vercel login/link)
#
# Manual: copy into Vercel → Settings → Environment Variables, then redeploy.
# =============================================================================

# --- Required ---
# Neon pooled connection string (Dashboard → Connection string → Pooled).
# Must include ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Flask session signing key (use a long random value, e.g. openssl rand -hex 32)
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Groq API key (AI reports) — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=

# --- Optional: mentor chat ---
# ZO_API_KEY=
# ZO_BASE_URL=https://api.zo.dev/v1/chat/completions
# ZO_MODEL=minimax 2.7
# ANTHROPIC_API_KEY=

# --- Optional: Cashfree payments ---
# CASHFREE_APP_ID=
# CASHFREE_API_KEY=
# CASHFREE_API_URL=https://api.cashfree.com/pg
# CASHFREE_FORM_ID=
# CASHFREE_SUBSCRIPTION_FORM_URL=
# CASHFREE_SUBSCRIPTION_FORM_ID=

# --- Notes ---
# Neon via Vercel Storage often creates prefixed vars such as:
#   database_POSTGRES_URL, database_POSTGRES_HOST, database_PGUSER, etc.
# The app auto-detects any env key ending in POSTGRES_URL / DATABASE_URL.
# Prefer the pooled URL (database_POSTGRES_URL). You do not need a separate
# plain DATABASE_URL unless you set it manually.
